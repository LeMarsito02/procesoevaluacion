# --- Django ---
DJANGO_SECRET_KEY=cambiar-por-una-clave-larga-aleatoria
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=mievaluador.lemartek.com
CORS_ORIGENES=https://mievaluador.lemartek.com
FRONTEND_URL=https://mievaluador.lemartek.com

# --- Base de datos ---
DB_NOMBRE=mievaluador
# Rol de la app: NO superusuario (lo crea despliegue/postgres-inicial.sh)
DB_USUARIO=mievaluador_app
DB_CLAVE=cambiar
# Superusuario solo para mantenimiento y respaldos
DB_ADMIN_USUARIO=mievaluador
DB_ADMIN_CLAVE=cambiar

# --- Correo (Hostinger) ---
CORREO_BACKEND=django.core.mail.backends.smtp.EmailBackend
CORREO_SERVIDOR=smtp.hostinger.com
CORREO_PUERTO=465
CORREO_USUARIO=no-responder.mievaluacion@lemartek.com
CORREO_CLAVE=cambiar
CORREO_REMITENTE=MiEvaluador <no-responder.mievaluacion@lemartek.com>

# --- Evaluación ---
MAX_WORKERS=4
LLM_URL=http://nodo-ia.lemarcloud.local:11434
LLM_MODELO=llama3.1:8b
RETENCION_DIAS=30
RESPALDO_DIAS=14

# --- Cifrado en reposo (RF-21) ---
# Clave de los archivos subidos y de la caché de ofertas (AES-256-GCM). Generarla con
#   docker compose run --rm api python manage.py cifrar_archivos --generar-clave
# y guardar una copia en la bóveda de la entidad: sin ella los archivos no se pueden leer.
# Para rotarla: la nueva primero, separadas por coma, y «cifrar_archivos --rotar».
CLAVE_CIFRADO_ARCHIVOS=
# Clave pública de age (age1…) para cifrar los respaldos; la privada NO va en este servidor.
RESPALDO_DESTINATARIO_AGE=
# Copia de los respaldos fuera del servidor principal (destino de rclone) y su configuración
# por variables (https://rclone.org/docs/#config-file), p. ej. un bucket S3:
RESPALDO_REMOTO=
# RCLONE_CONFIG_RESPALDOS_TYPE=s3
# RCLONE_CONFIG_RESPALDOS_PROVIDER=Other
# RCLONE_CONFIG_RESPALDOS_ENDPOINT=
# RCLONE_CONFIG_RESPALDOS_ACCESS_KEY_ID=
# RCLONE_CONFIG_RESPALDOS_SECRET_ACCESS_KEY=

# --- Límites de peticiones ---
# LeMarCloud (TLS) + nginx del contenedor web
PROXIES_CONFIABLES=2
LIMITE_ANONIMO=300/m
LIMITE_USUARIO=600/m
LIMITE_PESADO=60/h

# Inicio de sesión con Microsoft (Entra ID). Opcional; ver docs/DESPLIEGUE.md.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# organizations = cuentas de trabajo de cualquier directorio (se exige el de cada entidad).
MICROSOFT_DIRECTORIO=organizations
